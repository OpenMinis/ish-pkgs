# CMake toolchain file: fully static musl host (aarch64-swift-linux-musl)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT /usr/local/musl/aarch64)
set(CMAKE_C_COMPILER_TARGET aarch64-swift-linux-musl)
set(CMAKE_CXX_COMPILER_TARGET aarch64-swift-linux-musl)
set(CMAKE_Swift_COMPILER_TARGET aarch64-swift-linux-musl)
set(CMAKE_Swift_FLAGS_INIT "-sdk /usr/local/musl/aarch64 -resource-dir /usr/local/musl/aarch64/usr/lib/swift_static -static-stdlib -use-ld=lld")
set(CMAKE_Swift_COMPILER_WORKS TRUE)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
