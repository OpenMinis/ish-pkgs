+#if defined(__linux__) && SWIFT_STDLIB_HAS_DLADDR && !APPLE_OS_SYSTEM
+/// Turn a possibly relative path to an existing file into a malloc()ed
+/// absolute path, or return nullptr.
+char *
+_swift_copyAbsoluteExistingPath(const char *path) {
+  if (!path || !*path)
+    return nullptr;
 
+  char resolved[PATH_MAX];
+  if (::realpath(path, resolved))
+    return ::strdup(resolved);
+
+  // realpath() can itself depend on /proc (e.g. in Musl); fall back to
+  // joining with the current directory by hand.
+  if (path[0] == '/')
+    return ::access(path, F_OK) == 0 ? ::strdup(path) : nullptr;
+
+  char cwd[PATH_MAX];
+  if (!::getcwd(cwd, sizeof(cwd)))
+    return nullptr;
+
+  char *joined = _swift_joinPaths(cwd, path, nullptr);
+  if (joined && ::access(joined, F_OK) == 0)
+    return joined;
+
+  std::free(joined);
+  return nullptr;
+}
+
+/// Find the path of the running executable without dladdr(); used when
+/// statically linked.  Returns a malloc()ed string or nullptr.
+char *
+_swift_copyLinuxExecutablePath() {
+  char pathBuf[PATH_MAX];
+
+  // 1. /proc/self/exe.  Retry a few times since some environments fail this
+  //    call spuriously.
+  for (unsigned attempt = 0; attempt < 8; ++attempt) {
+    ssize_t len = ::readlink("/proc/self/exe", pathBuf, sizeof(pathBuf) - 1);
+    if (len > 0) {
+      pathBuf[len] = '\0';
+      return ::strdup(pathBuf);
+    }
+    if (len < 0 && (errno == ENOENT || errno == EACCES || errno == ENOTDIR))
+      break;
+  }
+
+#if SWIFT_PATHS_HAS_GETAUXVAL
+  // 2. The filename the kernel was asked to execute.  This may be relative
+  //    to the working directory at exec time.
+  if (const char *execFn = (const char *)::getauxval(AT_EXECFN)) {
+    if (char *result = _swift_copyAbsoluteExistingPath(execFn))
+      return result;
+  }
+#endif
+
+#if !defined(__ANDROID__)
+  // 3. argv[0], searching PATH if it has no directory component.
+  const char *argv0 = program_invocation_name;
+  if (argv0 && *argv0) {
+    if (std::strchr(argv0, '/')) {
+      if (char *result = _swift_copyAbsoluteExistingPath(argv0))
+        return result;
+    } else if (const char *searchPath = ::getenv("PATH")) {
+      const char *dir = searchPath;
+      while (*dir) {
+        const char *end = std::strchr(dir, ':');
+        size_t dirLen = end ? (size_t)(end - dir) : std::strlen(dir);
+        if (dirLen > 0 && dirLen < sizeof(pathBuf)) {
+          std::memcpy(pathBuf, dir, dirLen);
+          pathBuf[dirLen] = '\0';
+          char *candidate = _swift_joinPaths(pathBuf, argv0, nullptr);
+          if (candidate && ::access(candidate, X_OK) == 0) {
+            char *result = _swift_copyAbsoluteExistingPath(candidate);
+            std::free(candidate);
+            if (result)
+              return result;
+          } else {
+            std::free(candidate);
+          }
+        }
+        if (!end)
+          break;
+        dir = end + 1;
+      }
+    }
+  }
+#endif
+
+  return nullptr;
+}
+#endif
